# Example environment file for obs-effects-v2.
#
# Copy it to `.env` in this same directory:
#
#     cp .env.example .env
#
# Docker Compose reads `.env` automatically and substitutes the values into
# docker-compose.yml. Every variable below already has a sensible built-in
# default, so an empty `.env` (or no `.env` at all) works fine. Change a value
# only when the default clashes with something else on your machine.
#
# Never commit your real `.env` — it is listed in .gitignore.

# --- Database -----------------------------------------------------------------

# Connection string the *backend container* uses to reach MongoDB.
# `mongo` is the Compose service name and only resolves inside the Docker
# network. Do not change this to localhost: from the backend container,
# localhost means the backend container itself.
MONGO_URI=mongodb://mongo:27017

# Name of the logical database inside MongoDB. All collections (`effects`,
# `routes`) live under it. Using a different name gives you a clean slate
# without deleting anything.
MONGO_DB=obs_effects

# Port on *your machine* that MongoDB is published on, so tools like mongosh
# or MongoDB Compass can connect to localhost:27017. Change it if you already
# run a MongoDB locally on 27017.
MONGO_HOST_PORT=27017

# --- Backend ------------------------------------------------------------------

# Port the Scala HTTP server listens on *inside* its container.
# Leave this at 8080 unless you also update the container-side port mapping.
HTTP_PORT=8080

# Port on your machine that the backend is published on. Open
# http://localhost:8080/api/health to check the API is alive.
BACKEND_HOST_PORT=8080

# --- Admin password -----------------------------------------------------------
#
# READ THIS BEFORE YOUR FIRST `make up`. The backend refuses to start without a
# password hash and exits with status 1, so an empty value here means the
# backend container restarts in a loop and nothing works.
#
# The service never sees your password, only a bcrypt hash of it. Produce one
# with either command — both prompt for the password twice without echoing it,
# so it never reaches your shell history:
#
#     docker run --rm -it httpd:2.4-alpine htpasswd -nBC 12 "" | tail -1 | cut -d: -f2
#
#     docker compose run --rm --no-deps -e MILL_OUTPUT_DIR=/mill-tasks backend \
#       mill --no-daemon runMain obseffects.tools.HashPassword
#
# Both print one 60-character line beginning `$2y$12$` or `$2a$12$`. Paste it
# below, INSIDE SINGLE QUOTES. The quotes are not optional: a bcrypt hash is
# full of `$`, which both your shell and Docker Compose read as the start of a
# variable name, and without them most of the hash is replaced by nothing. If a
# login is refused and you are sure of the password, look at what actually
# arrived before concluding anything else:
#
#     docker compose exec backend printenv ADMIN_PASSWORD_HASH
#
ADMIN_PASSWORD_HASH=''

# Set to `true` to run with NO authentication at all: every admin endpoint
# answers as though you were signed in, and the backend prints a capitalised
# banner in its log saying the admin is open to anyone who can reach the port.
# This exists so that running unprotected has to be asked for out loud. Only for
# a throwaway experiment on a machine nobody else can reach.
ADMIN_AUTH_DISABLED=false

# How long a signed-in session lasts, in whole hours, and the session cookie's
# Max-Age. 168 is seven days. The lifetime is absolute: using the admin does not
# push it further out, so this is how often you sign in again.
SESSION_TTL_HOURS=168

# `true` adds the `Secure` attribute to the session cookie, telling the browser
# to send it over HTTPS only. It is off by default because the normal setup here
# is http://localhost, where browsers disagree about whether a Secure cookie is
# accepted at all. Turn it on as soon as this is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Comma-separated list of exact origins allowed to make *credentialed*
# cross-origin calls — that is, other origins whose pages may send the session
# cookie to this backend. Leave it unset for the default setup, where the
# browser only ever talks to http://localhost:3000 and the Vite dev server
# forwards /api onwards. You need it only if you also set VITE_API_BASE below to
# an absolute URL. Example: CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# --- Frontend -----------------------------------------------------------------

# Port on your machine for the Vite dev server: http://localhost:3000
FRONTEND_HOST_PORT=3000

# Base URL the *browser* uses for API calls.
#
# Leave it empty. Empty means the app uses the relative path `/api`, which the
# Vite dev server forwards to the backend container, so the browser only ever
# talks to one origin (http://localhost:3000). That is what makes the admin's
# session cookie a plain first-party cookie: no cross-origin rules, no preflight
# requests, nothing to configure.
#
# Set it to an absolute URL such as http://localhost:8080/api only if you want
# the browser to reach the backend directly instead of through the proxy. If you
# do, you must ALSO set CORS_ALLOWED_ORIGINS on the backend to name this app's
# origin — otherwise the browser refuses to send the session cookie, and signing
# in appears to work and then forgets you on the next click.
VITE_API_BASE=

# --- OBS audio ----------------------------------------------------------------

# There is deliberately NOTHING to set here, and that is worth a note, because it
# is the one piece of configuration you might come looking for in this file.
#
# Audio-reactive effects follow the audio OBS is broadcasting, which the backend
# reads over a WebSocket connection to OBS's own obs-websocket server. Where that
# server is, and its password, are configured in the admin panel under Settings
# and stored in MongoDB — not here.
#
# That is on purpose. An environment variable cannot be changed without editing a
# file and restarting the container, and the whole point is that an operator who
# mistypes their OBS password fixes it in a form and presses Save, not in the
# middle of a live broadcast.
#
#     http://localhost:3000/admin/settings
#
# One thing that IS in this repository's compose file and worth knowing about: the
# backend gets an `extra_hosts` entry mapping host.docker.internal to the host
# machine, because that is where OBS runs. Inside a container, `localhost` is the
# container itself and would never find it.

# --- Optional tools -----------------------------------------------------------

# Port for mongo-express, the web-based database browser. It only starts when
# you ask for the `tools` profile:
#     docker compose --profile tools up -d mongo-express
MONGO_EXPRESS_HOST_PORT=8081
