{
  "name": "obs-effects-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node tools/verify/run.mjs",
    "new:effect": "node tools/new-effect.mjs"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.17",
    "@solidjs/web": "2.0.0-rc.1",
    "pixi.js": "8.20.0",
    "solid-js": "2.0.0-rc.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@solidjs/vite-plugin": "3.0.0-next.32",
    "@types/node": "24.13.0",
    "@types/three": "0.185.4",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-solid": "0.16.0",
    "playwright-core": "1.50.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2"
  }
}
