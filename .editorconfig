# EditorConfig helps keep formatting consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.scala]
indent_size = 2
max_line_length = 120

[*.{md,markdown}]
# Markdown uses two trailing spaces for a hard line break, so do not strip them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml,json,jsonc}]
indent_size = 2
